{
  "name": "rn-dep-scanner",
  "version": "1.3.13",
  "description": "React Native project health CLI: dependency compatibility, breaking changes, New Architecture/Expo support, native Android/iOS toolchain checks, transitive OSV.dev security scanning, license/SBOM/policy reporting, and dependency graph tooling",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "rn-dep-scanner": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "tsx --test",
    "prepare": "npm run build"
  },
  "keywords": [
    "react-native",
    "reactnative",
    "dependencies",
    "dependency-check",
    "compatibility",
    "npm",
    "cli",
    "mobile",
    "security",
    "vulnerability-scanner",
    "sbom",
    "license-checker",
    "new-architecture",
    "expo",
    "hermes",
    "doctor",
    "upgrade",
    "typescript"
  ],
  "author": "amit13091992@gmail.com",
  "license": "MIT",
  "preferGlobal": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/semver": "^7.8.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
